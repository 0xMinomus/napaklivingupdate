# Production environment — copy to .env and fill in.

# PostgreSQL credentials (CHANGE the password before first deploy).
POSTGRES_USER=napak
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=napak_living

# Public URL of the deployed site (used for CORS).
CLIENT_ORIGIN=https://yourdomain.com

# Host port for the web service (80 = HTTP default).
WEB_PORT=80