# Napak Living — environment configuration
# Copy to .env and adjust for your local setup.

# PostgreSQL connection string used by Prisma (migrate, generate, runtime).
DATABASE_URL="postgresql://napak:napak@localhost:5432/napak_living?schema=public"

# Backend API origin (used by the Vite dev proxy when not set).
API_URL="http://localhost:3000"

# Port the Fastify API listens on.
PORT=3000

# Frontend API base used at build time (VITE_* is exposed to the browser).
# Defaults to "/api" (same origin via Vite proxy in dev / reverse proxy in prod).
VITE_API_URL="/api"