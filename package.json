{
  "name": "napak-living",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Napak Living — full-stack home decor catalog site",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"npm:dev:web\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "npm run dev --workspace server",
    "dev:all": "npm run dev",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "npm run db:migrate --workspace server",
    "db:seed": "npm run db:seed --workspace server",
    "db:setup": "npm run db:setup --workspace server"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  }
}
